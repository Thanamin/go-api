# .env.example - copy to .env and fill values

# Application port
PORT=3000

# PostgreSQL database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_api_db
DB_SSLMODE=disable

# Password hashing configuration
HASH_METHOD=bcrypt
HASH_SECRET=your-secret-key-change-this-in-production
BCRYPT_COST=10

# JWT configuration
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRATION_HOURS=24
